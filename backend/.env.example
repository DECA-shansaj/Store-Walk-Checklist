# Copy to .env and fill in for your environment.
# Never commit real secrets. Never put these values in the static client.

PORT=3080

# Comma-separated browser origins allowed to call the API (GitHub Pages, intranet URL, etc.)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://deca-shansaj.github.io

# Where JSON records are stored (relative to backend folder or absolute path)
DATA_DIR=./data

# Default notify address if client omits notifyEmail
DEFAULT_NOTIFY_EMAIL=deca.lee.store-ops-grp.list.websitez09gulfport@mail.mil

# Email transport: "log" (default, safe) or "smtp"
EMAIL_TRANSPORT=log

# Only used when EMAIL_TRANSPORT=smtp — set via environment, not in client code
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=store-walk-noreply@example.mil
